    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--primary);
    background: rgba(14, 165, 233, 0.08);
    border-radius: 0.5rem;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
}
.application-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--headerColor);
    margin: 0 0 0.25rem;
}
.application-text {
    font-size: 0.8125rem;
    color: #64748b;
    margin: 0;
    line-height: 1.55;
}

/* Process list */
.process-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    counter-reset: process;
}
.process-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.125rem 1.25rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
}
.process-item:hover {
    border-color: transparent;
    box-shadow: 0 8px 24px rgba(0, 86, 179, 0.12);
    transform: translateX(3px);
}
.process-num {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, var(--primary), #0056b3);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    box-shadow: 0 3px 10px rgba(0, 86, 179, 0.2);
}
.process-item h4 {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--headerColor);
    margin: 0 0 0.25rem;
}
.process-item p {
    font-size: 0.8125rem;
    color: #64748b;
    margin: 0;
    line-height: 1.55;
}

/* Responsive adjustments */
@media only screen and (max-width: 48rem) {
    /* 2x2 grid on phones so every area stays visible */
    #research-nav .cs-container {
        padding: 0.75rem 1rem;
    }
    #research-nav .cs-tabs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.375rem;
        width: 100%;
        padding: 0.375rem;
        border-radius: 1rem;
        box-sizing: border-box;
    }
    #research-nav .cs-tab {
        padding: 0.3125rem 0.5rem 0.3125rem 0.3125rem;
        gap: 0.4rem;
        font-size: 0.75rem;
        line-height: 1.25;
        white-space: normal;
        text-align: left;
        border-radius: 0.75rem;
    }
    #research-nav .cs-tab-icon {
        width: 1.75rem;
        height: 1.75rem;
        padding: 0.3125rem;
    }
    .tech-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}
@media only screen and (max-width: 30rem) {
    .tech-grid,
    .performance-grid {
        grid-template-columns: 1fr;
    }
}

/* Tab content visibility */
.project-content {
    display: none;
}
.project-content.project-active {
    display: block;
    animation: fadeSlideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
@keyframes fadeSlideIn {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

