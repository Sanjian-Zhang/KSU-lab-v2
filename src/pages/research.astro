/* ============================================ */
.ug-contribute {
    background: linear-gradient(135deg, #f0f7ff 0%, #e8f4fd 100%);
    border-radius: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid rgba(14, 165, 233, 0.15);
}
.ug-contribute-title {
    color: var(--primary);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.ug-contribute-title::before {
    content: "";
    width: 4px;
    height: 1.25rem;
    background: linear-gradient(180deg, var(--primary), #0ea5e9);
    border-radius: 2px;
}
.ug-contribute-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    margin-bottom: 0.75rem;
}
.ug-contribute-table th {
    text-align: left;
    padding: 0.625rem 0.75rem;
    font-weight: 700;
    color: var(--headerColor);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 2px solid rgba(14, 165, 233, 0.25);
}
.ug-contribute-table td {
    padding: 0.75rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    vertical-align: top;
    line-height: 1.5;
}
.ug-contribute-table tbody tr:last-child td {
    border-bottom: none;
}
.ug-contribute-table tbody tr:hover td {
    background: rgba(14, 165, 233, 0.04);
}
.ug-skills {
    white-space: nowrap;
    color: var(--primary);
    font-weight: 600;
    font-size: 0.875rem;
}
.ug-note {
    font-size: 0.875rem;
    color: #64748b;
    margin: 0.5rem 0 0;
    font-style: italic;
}

/* ============================================ */
/* Precision Testing (Side By Side Reverse)      */
/* ============================================ */
.precision-sbsr {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: clamp(1.5rem, 3vw, 2.5rem) 0;
}
.precision-sbsr-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}
.precision-sbsr-topper {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
}
.precision-sbsr-title {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--headerColor);
    margin: 0;
    line-height: 1.25;
}
.precision-sbsr-text {
    font-size: clamp(0.9375rem, 1.7vw, 1.0625rem);
    color: var(--bodyTextColor);
    line-height: 1.6;
    margin: 0.5rem 0 0;
}
.precision-sbsr-visual {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 61, 128, 0.12);
    aspect-ratio: 1 / 1;
}
.precision-sbsr-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.precision-sbsr-box {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-radius: 0.75rem;
    padding: 0.875rem 1.125rem;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    max-width: calc(100% - 2rem);
}
.precision-sbsr-number {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    white-space: nowrap;
}
.precision-sbsr-box-info h4 {
    margin: 0 0 0.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--headerColor);
}
.precision-sbsr-box-info span {
    font-size: 0.75rem;
    color: #64748b;
    line-height: 1.4;
}

@media (min-width: 64rem) {
    .precision-sbsr {
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 3rem;
    }
    /* Reverse: visual on left, content on right */
    .precision-sbsr-content { order: 2; }
    .precision-sbsr-visual { order: 1; }
    .precision-sbsr-box {
        bottom: 1.5rem;
        left: 1.5rem;
        padding: 1rem 1.5rem;
    }
    .precision-sbsr-number { font-size: 2.25rem; }
    .precision-sbsr-box-info h4 { font-size: 0.9375rem; }
    .precision-sbsr-box-info span { font-size: 0.8125rem; }
}

@media (min-width: 48rem) and (max-width: 63.9375rem) {
    .precision-sbsr-visual { aspect-ratio: 16 / 10; }
}

/* ============================================ */
/* Interested in This Research CTA               */
/* ============================================ */
.research-interested {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: linear-gradient(135deg, #003d80, var(--primary));
    border-radius: 1rem;
    color: #fff;
    flex-wrap: wrap;
}
.interested-left h3 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: #fff;
}
.interested-left p {
    margin: 0;
    font-size: 0.9375rem;
    opacity: 0.85;
}
.interested-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: #fff;
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: transform 0.2s, box-shadow 0.2s;
    white-space: nowrap;
}
.interested-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
}

@media (max-width: 48rem) {
    .ug-contribute-table {
        font-size: 0.875rem;
    }
    .ug-contribute-table th, .ug-contribute-table td {
        padding: 0.5rem 0.5rem;
        display: block;
        width: 100%;
    }
    .ug-contribute-table th {
        border-bottom: none;
        padding-bottom: 0.25rem;
    }
    .ug-contribute-table td {
        border-bottom: 1px dashed rgba(0, 0, 0, 0.1);
    }
    .ug-contribute-table tbody tr {
        display: block;
        margin-bottom: 0.75rem;
    }
    .research-interested {
        flex-direction: column;
        text-align: center;
    }
}
</style>

<script is:inline>
    // Sticky nav scroll effect
    const nav = document.getElementById('research-nav');
    if (nav) {
        window.addEventListener('scroll', () => {
            nav.classList.toggle('is-scrolled', window.scrollY > 10);
        }, { passive: true });
    }

    // Tab switching (click to show/hide content)
    const tabsContainer = document.getElementById('research-nav');
    const tabs = tabsContainer ? tabsContainer.querySelectorAll('.cs-tab') : [];
    const contents = document.querySelectorAll('.project-content');

    function switchTab(tab) {
        const target = tab.getAttribute('data-tab');
        if (!target) return;

        tabs.forEach(t => t.classList.remove('cs-tab-active'));
        contents.forEach(c => c.classList.remove('project-active'));

        tab.classList.add('cs-tab-active');
        const targetContent = document.getElementById(target + '-content');
        if (targetContent) targetContent.classList.add('project-active');
    }

    tabs.forEach(tab => {
        tab.addEventListener('click', () => switchTab(tab));
    });
</script>
