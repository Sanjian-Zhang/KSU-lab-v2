---
import BaseLayout from "src/layouts/BaseLayout.astro";
import ResearchVideo from "@components/ResearchVideo.astro";

// Put a video file in public/assets/videos/ (or paste a YouTube/Vimeo link)
// and set `src` below. An empty `src` shows a placeholder.
const videos = {
  ml: {
    src: "",
    poster: "",
    title: "HeartSimSage Simulation",
    caption: "Video: HeartSimSage predicting cardiac tissue deformation compared with finite element results.",
  },
  multiscale: {
    src: "",
    poster: "",
    title: "Electromechanical Digital Twin",
    caption: "Video: Patient-specific simulation coupling electrical activity with organ motion.",
  },
  constitutive: {
    src: "",
    poster: "",
    title: "Soft Tissue Material Response",
    caption: "Video: Simulated tensile response of soft tissue under large deformation.",
  },
  experiments: {
    src: "",
    poster: "",
    title: "Mechanical Testing in Action",
    caption: "Video: Tissue specimen tested in the Instron Biopuls biobath.",
  },
