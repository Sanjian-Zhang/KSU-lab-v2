</section>

</BaseLayout>




<style lang="less">

/*-- -------------------------- -->
<---           Hero             -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
    #hero-2150 {
        /* 300px - 400px on top - leaving extra space for the navigation */
        /* 60px - 100px on bottom */
        padding: clamp(10rem, 40vw, 25rem) (16/16rem) clamp(3.75rem, 7.5vw, 6.25rem) (16/16rem);
        /* prevents the topper line from causing an overflow */
        overflow: hidden;
        position: relative;
        z-index: 1;

        .cs-container {
            width: 100%;
            /* changes to 1280px at tablet */
            max-width: (704/16rem);
            margin: auto;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            /* 48px - 60px */
            gap: clamp(3rem, 6vw, 3.75rem);
        }

        .cs-content {
            text-align: center;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .cs-title {
            /* 39px - 61px */
            position: relative;
            top: -130px;
            font-size: clamp(3rem, 6vw, 5rem);
            max-width: 30ch;
            color: var(--bodyTextColorWhite);
        }
        
        .cs-topper {
            font-size: clamp(1rem, 1.6vw, 1.4rem);
            position: relative;
            top: -130px;
            color: var(--csTopperColor);
        }

        .cs-text {
            /* 16px - 20px */
            position: relative;
            top: 50px;
            font-size: clamp(1rem, 2vw, 1.25rem);
            max-width: 55ch;
            margin-bottom: (32/16rem);
            color: var(--bodyTextColorWhite);
            opacity: 0.8;
        }

        .cs-button-solid {
            position: relative;
            top: 50px;
            font-size: (16/16rem);
            font-weight: 700;
            /* 46px - 56px */
            line-height: clamp(2.875rem, 5.5vw, 3.5rem);
            text-align: center;
            text-decoration: none;
            min-width: (200/16rem);
            margin: 0;
            /* prevents padding from adding to the width */
            box-sizing: border-box;
            /* 32px - 48px */
            padding: 0 clamp(2rem, 4vw, 3rem);
            background-color: var(--primary);
            color: var(--bodyTextColorWhite);
            display: inline-block;
            position: relative;
            z-index: 1;
            transition: color 0.3s;

            &:before {
                content: "";
                width: 0%;
                height: 100%;
                background: #ffffff;
                opacity: 1;
                position: absolute;
                top: 0;
                left: 0;
                z-index: -1;
                transition: width 0.3s;
            }

            &:hover {
                color: var(--headerColor);

                &:before {
                    width: 100%;
                }
            }
        }

        .cs-card-group {
            width: 100%;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            /* 32px - 60px */
            row-gap: clamp(2rem, 4vw, 3.75rem);
        }

        .cs-item {
            text-align: left;
            list-style: none;
            width: 100%;
            margin: 0;
            box-sizing: border-box;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            grid-column: span 12;
            gap: (16/16rem);
        }

        .cs-icon-group {
            margin: 0;
            display: flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            gap: (8/16rem);
        }

        .cs-icon {
            width: (32/16rem);
            height: auto;
            display: block;
        }

        .cs-h3 {
            /* 20px - 25px */
            font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
            font-weight: 700;
            line-height: 1.2em;
            text-align: inherit;
            margin: 0;
            color: var(--bodyTextColorWhite);
            transition: color 0.3s;
        }

        .cs-item-text {
            /* 16px - 20px */
            font-size: clamp(1rem, 2vw, 1.25rem);
            line-height: 1.5em;
            text-align: inherit;
            margin: 0;
            color: #F7F7F7;
            opacity: 0.8;
        }

        .cs-background {
          width: 100%;
          height: 100%;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        
          &:before {
            content: "";
            width: 100%;
            height: 100%;
            background: linear-gradient(0deg, rgba(0, 0, 0, 0.50) 0%, rgba(0, 0, 0, 0.50) 100%);
            pointer-events: none;
            opacity: 1;
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
          }
      
          .cs-slideshow {
            width: 100%;
            height: 100%;
            background-color: #1a1a1a;
            position: absolute;
            top: 0;
            left: 0;
            overflow: hidden;
          }

          .cs-track {
            height: 100%;
            display: flex;
            transition: transform 0.6s ease;
            will-change: transform;
          }

          .cs-slide-frame {
            flex: 0 0 100%;
            width: 100%;
            min-width: 100%;
            height: 100%;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
          }

          /* Portrait: blurred backdrop + full image (set via JS .is-portrait) */
          &.is-portrait {
            .cs-slide-bg {
              display: block;
            }

            .cs-slide {
              position: relative;
              z-index: 1;
              max-width: 100%;
              max-height: 100%;
              width: auto;
              height: auto;
              object-fit: contain;
              object-position: center;
            }
          }

          .cs-slide-bg {
            display: none;
            position: absolute;
            inset: -10%;
            width: 120%;
            height: 120%;
            object-fit: cover;
            object-position: center;
            filter: blur(28px) brightness(0.45) saturate(1.15);
            transform: scale(1.08);
            pointer-events: none;
          }

          .cs-slide {
            position: absolute;
            inset: 0;
            z-index: 1;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
          }

          /* Landscape: single layer, fill the hero */
          &.is-landscape {
            .cs-slide-bg {
              display: none;
            }

            .cs-slide {
              max-width: none;
              max-height: none;
            }
          }
        }

        .cs-slideshow-controls {
          position: absolute;
          inset: 0;
          z-index: 2;
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 0 (12/16rem);
          pointer-events: none;
        }

        .cs-slideshow-btn {
          pointer-events: auto;
          width: (44/16rem);
          height: (44/16rem);
          padding: 0;
          border: 1px solid rgba(255, 255, 255, 0.45);
          border-radius: 50%;
          background: rgba(0, 0, 0, 0.45);
          color: #fff;
          display: flex;
          align-items: center;
          justify-content: center;
          cursor: pointer;
          transition:
            background-color 0.2s,
            border-color 0.2s,
            transform 0.2s;

          svg {
            width: (26/16rem);
            height: (26/16rem);
            fill: currentColor;
          }

          &:hover {
            background: rgba(0, 0, 0, 0.65);
            border-color: rgba(255, 255, 255, 0.85);
          }

          &:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
          }

          &:active {
            transform: scale(0.96);
          }
        }
    }
