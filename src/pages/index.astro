</style>

<script is:inline>
(function () {
  const ITEMS_PER_PAGE = 4;
  const items = document.querySelectorAll('.cs-news-item');
  const pagination = document.getElementById('news-pagination');
  if (!items.length || !pagination) return;

  const totalPages = Math.ceil(items.length / ITEMS_PER_PAGE);
  let currentPage = 1;

  function showPage(page) {
    currentPage = Math.max(1, Math.min(page, totalPages));
    items.forEach((el, i) => {
      const idx = i + 1;
      const onPage = idx >= (currentPage - 1) * ITEMS_PER_PAGE + 1 && idx <= currentPage * ITEMS_PER_PAGE;
      el.classList.toggle('is-visible', onPage);
    });
    renderPagination();
  }

  function renderPagination() {
    pagination.innerHTML = '';

    const prev = document.createElement('button');
    prev.textContent = '‹ Prev';
    prev.disabled = currentPage === 1;
    prev.addEventListener('click', () => showPage(currentPage - 1));
    pagination.appendChild(prev);

    const windowSize = 1;
    const pages = new Set();
    pages.add(1);
    pages.add(totalPages);
    for (let i = currentPage - windowSize; i <= currentPage + windowSize; i++) {
      if (i >= 1 && i <= totalPages) pages.add(i);
    }
    const sorted = [...pages].sort((a, b) => a - b);

    sorted.forEach((p, idx) => {
      if (idx > 0 && p - sorted[idx - 1] > 1) {
        const span = document.createElement('span');
        span.className = 'cs-page-ellipsis';
        span.textContent = '…';
        pagination.appendChild(span);
      }
      const btn = document.createElement('button');
      btn.textContent = p;
      if (p === currentPage) btn.classList.add('cs-page-active');
      btn.addEventListener('click', () => showPage(p));
      pagination.appendChild(btn);
    });

    const next = document.createElement('button');
    next.textContent = 'Next ›';
    next.disabled = currentPage === totalPages;
    next.addEventListener('click', () => showPage(currentPage + 1));
    pagination.appendChild(next);
  }

  showPage(1);
  document.addEventListener('astro:after-swap', () => showPage(1));
})();
</script>
