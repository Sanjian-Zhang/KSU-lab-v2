---
import BaseLayout from "src/layouts/BaseLayout.astro";
import CTA from "@components/CTA.astro";
import FAQ from "@components/Faq.astro";
import fs from "node:fs";
import path from "node:path";

const heroDir = path.resolve(process.cwd(), "public/assets/images/hero");
const imageExt = new Set([".jpg", ".jpeg", ".png", ".webp", ".avif"]);

const defaultImage = "Image -2.jpg";

const heroImages = fs.existsSync(heroDir)
  ? fs
      .readdirSync(heroDir, { withFileTypes: true })
      .filter(
        (entry) =>
          entry.isFile() && imageExt.has(path.extname(entry.name).toLowerCase())
      )
      .map((entry) => `/assets/images/hero/${encodeURIComponent(entry.name)}`)
      .sort((a, b) => {
        if (a.includes(defaultImage)) return -1;
        if (b.includes(defaultImage)) return 1;
        return a.localeCompare(b);
      })
  : [];

const newsTopics = [
  { slug: "research", label: "Research" },
  { slug: "collaboration", label: "Collaboration" },
  { slug: "visitors", label: "Visitors" },
  { slug: "awards", label: "Awards & Recognition" },
  { slug: "students", label: "Students" },
  { slug: "lab-life", label: "Lab Life" },
];

