</style>

<script>
  const ITEMS_PER_PAGE = 5;

  function initCarousel(carousel: HTMLElement) {
    const track = carousel.querySelector<HTMLElement>(".cs-carousel-track");
    if (!track) return;
    const total = track.querySelectorAll("img").length;
    const dots = carousel.querySelectorAll(".cs-carousel-dot");
    let current = 0;

    const goTo = (index: number) => {
      current = (index + total) % total;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) => dot.classList.toggle("is-active", i === current));
    };

    carousel.querySelector(".cs-carousel-prev")?.addEventListener("click", () => goTo(current - 1));
    carousel.querySelector(".cs-carousel-next")?.addEventListener("click", () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

    carousel.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") goTo(current - 1);
      if (e.key === "ArrowRight") goTo(current + 1);
    });

    let startX = 0;
    track.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener("touchend", (e) => {
      const diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goTo(current + (diff > 0 ? 1 : -1));
    }, { passive: true });
  }

  function setExpanded(text: HTMLElement, button: HTMLElement, expanded: boolean) {
    button.setAttribute("aria-expanded", String(expanded));
    button.textContent = expanded ? "Show less" : "Read more";

    if (expanded) {
      text.classList.add("is-expanded");
      text.style.maxHeight = `${text.scrollHeight}px`;
      text.addEventListener("transitionend", () => {
        if (text.classList.contains("is-expanded")) text.style.maxHeight = "none";
      }, { once: true });
    } else {
      text.style.maxHeight = `${text.scrollHeight}px`;
      void text.offsetHeight;
      text.classList.remove("is-expanded");
      text.style.maxHeight = "";
    }
  }

  // Only show "Read more" when the text is actually taller than the collapsed height
  function measureCollapsible(item: HTMLElement) {
    const text = item.querySelector<HTMLElement>(".cs-news-text");
    const button = item.querySelector<HTMLElement>(".cs-read-more");
    if (!text || !button || text.classList.contains("is-expanded")) return;

    text.classList.remove("is-collapsible");
    const fullHeight = text.scrollHeight;
    text.classList.add("is-collapsible");
    const needsToggle = fullHeight > text.clientHeight + 24;

    text.classList.toggle("is-collapsible", needsToggle);
    button.hidden = !needsToggle;
  }

  function initNews() {
    const section = document.getElementById("news-page");
    if (!section || section.dataset.newsInit === "true") return;
    section.dataset.newsInit = "true";

    const list = document.getElementById("news-list") as HTMLElement;
    const pagination = document.getElementById("news-pagination") as HTMLElement;
    const status = document.getElementById("news-status") as HTMLElement;
    const empty = document.getElementById("news-empty") as HTMLElement;
    const search = document.getElementById("news-search") as HTMLInputElement;
    const sort = document.getElementById("news-sort") as HTMLSelectElement;
    const chips = section.querySelectorAll<HTMLButtonElement>(".cs-filter-chip");
    const items = Array.from(list.querySelectorAll<HTMLElement>(".cs-news-item"));

    const state = { topic: "all", query: "", sort: "newest", page: 1 };

    items.forEach((item) => {
      const carousel = item.querySelector<HTMLElement>(".cs-carousel");
      if (carousel) initCarousel(carousel);

      const text = item.querySelector<HTMLElement>(".cs-news-text");
      const button = item.querySelector<HTMLElement>(".cs-read-more");
      button?.addEventListener("click", () => {
        if (!text) return;
        const expanded = button.getAttribute("aria-expanded") !== "true";
        setExpanded(text, button, expanded);
        if (!expanded && item.getBoundingClientRect().top < 0) {
          item.scrollIntoView({ block: "start" });
        }
      });

      item.querySelectorAll<HTMLElement>(".cs-topic-link").forEach((link) => {
        link.addEventListener("click", () => {
          setTopic(link.dataset.topic || "all");
          list.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });
    });

    const searchText = new Map(
      items.map((item) => [item, (item.textContent || "").toLowerCase().replace(/\s+/g, " ")])
    );

    function matches(item: HTMLElement) {
      const topics = (item.dataset.topics || "").split(" ");
      if (state.topic !== "all" && !topics.includes(state.topic)) return false;
      const words = state.query.toLowerCase().split(/\s+/).filter(Boolean);
      const haystack = searchText.get(item) || "";
      return words.every((word) => haystack.includes(word));
    }

    function render(scroll = false) {
      const sorted = [...items].sort((a, b) => {
        const diff = (a.dataset.date || "").localeCompare(b.dataset.date || "");
        return state.sort === "oldest" ? diff : -diff;
      });
      sorted.forEach((item) => list.appendChild(item));

      const visible = sorted.filter(matches);
      const totalPages = Math.max(1, Math.ceil(visible.length / ITEMS_PER_PAGE));
      state.page = Math.min(Math.max(1, state.page), totalPages);
      const start = (state.page - 1) * ITEMS_PER_PAGE;
      const pageItems = new Set(visible.slice(start, start + ITEMS_PER_PAGE));

      items.forEach((item) => { item.hidden = !pageItems.has(item); });
      pageItems.forEach(measureCollapsible);

      empty.hidden = visible.length > 0;
      status.textContent = visible.length
        ? `Showing ${start + 1}–${start + pageItems.size} of ${visible.length} ${visible.length === 1 ? "story" : "stories"}`
        : "";

      renderPagination(totalPages, visible.length > 0);

      if (scroll && list.getBoundingClientRect().top < 0) {
        list.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    function renderPagination(totalPages: number, hasResults: boolean) {
      pagination.innerHTML = "";
      if (!hasResults || totalPages < 2) return;

      const addButton = (label: string, page: number, opts: { disabled?: boolean; active?: boolean; aria?: string } = {}) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = label;
        btn.disabled = !!opts.disabled;
        if (opts.aria) btn.setAttribute("aria-label", opts.aria);
        if (opts.active) {
          btn.classList.add("cs-page-active");
          btn.setAttribute("aria-current", "page");
        }
        btn.addEventListener("click", () => {
          state.page = page;
          render(true);
        });
        pagination.appendChild(btn);
      };

      addButton("‹ Prev", state.page - 1, { disabled: state.page === 1, aria: "Previous page" });

      const pages = new Set([1, totalPages]);
      for (let i = state.page - 1; i <= state.page + 1; i++) {
        if (i >= 1 && i <= totalPages) pages.add(i);
      }
      const sortedPages = [...pages].sort((a, b) => a - b);

      sortedPages.forEach((page, idx) => {
        if (idx > 0 && page - sortedPages[idx - 1] > 1) {
          const gap = document.createElement("span");
          gap.className = "cs-page-ellipsis";
          gap.textContent = "…";
          pagination.appendChild(gap);
        }
        addButton(String(page), page, { active: page === state.page, aria: `Page ${page}` });
      });

      addButton("Next ›", state.page + 1, { disabled: state.page === totalPages, aria: "Next page" });
    }

    function setTopic(topic: string) {
      state.topic = topic;
      state.page = 1;
      chips.forEach((chip) => {
        const active = chip.dataset.topic === topic;
        chip.classList.toggle("is-active", active);
        chip.setAttribute("aria-pressed", String(active));
      });
      render();
    }

    chips.forEach((chip) => chip.addEventListener("click", () => setTopic(chip.dataset.topic || "all")));

    let searchTimer: ReturnType<typeof setTimeout> | undefined;
    search.addEventListener("input", () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        state.query = search.value.trim();
        state.page = 1;
        render();
      }, 150);
    });

    sort.addEventListener("change", () => {
      state.sort = sort.value;
      state.page = 1;
      render();
    });

    document.getElementById("news-reset")?.addEventListener("click", () => {
      search.value = "";
      state.query = "";
      sort.value = "newest";
      state.sort = "newest";
      setTopic("all");
    });

    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => items.filter((item) => !item.hidden).forEach(measureCollapsible), 150);
    });

    render();
  }

  document.addEventListener("astro:page-load", initNews);
</script>
