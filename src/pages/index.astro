const topicLabel = Object.fromEntries(newsTopics.map((t) => [t.slug, t.label]));
const topicCount = (slug: string) => news.filter((item) => item.topics.includes(slug)).length;
---

<BaseLayout
  title="News - Intelligent Biomechanics Lab"
  description="Explore research, lab activities, and news from the Intelligent Biomechanics Lab at Kennesaw State University."
>

<!-- ============================================ -->
<!--                    Hero                      -->
<!-- ============================================ -->

<section id="hero-2150">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">Welcome to the</span>
            <h1 class="cs-title">Intelligent Biomechanics Lab</h1>
            <p class="cs-text">
                The Intelligent Biomechanics Lab, where biomechanics meets artificial intelligence.
            </p>
            <a href="/contact" class="cs-button-solid cs-button1">Learn more from us</a>
        </div>
        <ul class="cs-card-group">
            <li class="cs-item">
                <div class="cs-icon-group">
                    <picture class="cs-icon-picture">
                    </picture>
                    <h3 class="cs-h3"></h3>
                </div>
                <p class="cs-item-text"></p>
            </li>
            <li class="cs-item">
                <div class="cs-icon-group">
                    <picture class="cs-icon-picture">
                    </picture>
                    <h3 class="cs-h3"></h3>
                </div>
                <p class="cs-item-text"></p>
            </li>
            <li class="cs-item">
                <div class="cs-icon-group">
                    <picture class="cs-icon-picture">
                    </picture>
                    <h3 class="cs-h3"></h3>
                </div>
                <p class="cs-item-text"></p>
            </li>
        </ul>
    </div>
    <!-- Background Slideshow -->
    <div class="cs-background">
      {heroImages.length > 0 ? (
        <div
          class="cs-slideshow"
          data-hero-slideshow
          data-interval="20000"
          data-slide-count={heroImages.length}
          data-landscape-ratio="1.15"
        >
          <div class="cs-track" aria-live="polite">
            {heroImages.map((src) => (
              <div class="cs-slide-frame">
                <img
                  src={src}
                  alt=""
                  class="cs-slide-bg"
                  loading="eager"
                  decoding="async"
                  aria-hidden="true"
                />
                <img
                  src={src}
                  alt=""
                  class="cs-slide"
                  loading="eager"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </div>
      ) : null}
    </div>
    {heroImages.length > 1 ? (
      <div class="cs-slideshow-controls">
              <button
                type="button"
                class="cs-slideshow-btn cs-slideshow-prev"
                aria-label="Previous slide"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
                </svg>
              </button>
              <button
                type="button"
                class="cs-slideshow-btn cs-slideshow-next"
                aria-label="Next slide"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="m10 6-1.41 1.41L13.17 12l-4.58 4.59L10 18l6-6z" />
                </svg>
              </button>
      </div>
    ) : null}
</section>

<script>
  function classifyHeroSlideFrame(frame: Element, landscapeMinRatio: number) {
    const img = frame.querySelector(".cs-slide");
    if (!(img instanceof HTMLImageElement)) return;

    const apply = () => {
      const { naturalWidth, naturalHeight } = img;
      if (!naturalWidth || !naturalHeight) return;
      const aspectRatio = naturalWidth / naturalHeight;
      const isLandscape = aspectRatio >= landscapeMinRatio;
      frame.classList.toggle("is-landscape", isLandscape);
      frame.classList.toggle("is-portrait", !isLandscape);
    };

    if (img.complete) apply();
    else img.addEventListener("load", apply, { once: true });
  }

  function initHeroSlideshow() {
    document.querySelectorAll("[data-hero-slideshow]").forEach((root) => {
      if (root instanceof HTMLElement && root.dataset.heroInit === "true") return;

      const track = root.querySelector(".cs-track");
      const slides = root.querySelectorAll(".cs-slide-frame");
      const heroSection = root.closest("#hero-2150");
      const prevBtn = heroSection?.querySelector(".cs-slideshow-prev");
      const nextBtn = heroSection?.querySelector(".cs-slideshow-next");
      if (!(track instanceof HTMLElement) || slides.length === 0) return;

      const landscapeMinRatio = Number.parseFloat(
        root.getAttribute("data-landscape-ratio") || "1.15"
      );
      slides.forEach((frame) =>
        classifyHeroSlideFrame(frame, landscapeMinRatio)
      );

      if (root instanceof HTMLElement) root.dataset.heroInit = "true";

      const intervalMs = Number.parseInt(root.dataset.interval || "20000", 10);
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      let index = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      const goTo = (nextIndex: number) => {
        index = ((nextIndex % slides.length) + slides.length) % slides.length;
        track.style.transform = `translateX(-${index * 100}%)`;
      };

      const next = () => goTo(index + 1);
      const prev = () => goTo(index - 1);

      const resetTimer = () => {
        if (timer) clearInterval(timer);
        if (slides.length > 1 && !prefersReducedMotion) {
          timer = setInterval(next, intervalMs);
        }
      };

      prevBtn?.addEventListener("click", () => {
        prev();
        resetTimer();
      });
      nextBtn?.addEventListener("click", () => {
        next();
        resetTimer();
      });

      goTo(0);
      resetTimer();
    });
  }

  initHeroSlideshow();
  document.addEventListener("astro:after-swap", initHeroSlideshow);
</script>
                                
                                                        
<!-- ============================================ -->
<!--                    News                       -->
<!-- ============================================ -->

<section id="news-page">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">News</span>
            <h2 class="cs-title">Lab Highlights & Milestones</h2>
            <p class="cs-text">From hands-on testing sessions to internal training and visiting collaborators,
                these highlights reflect the day-to-day work that drives the Intelligent Biomechanics Lab forward.</p>
        </div>

        <div class="cs-news-toolbar">
            <div class="cs-news-filters" role="group" aria-label="Filter news by topic">
                <button type="button" class="cs-filter-chip is-active" data-topic="all" aria-pressed="true">
                    All <span class="cs-chip-count">{news.length}</span>
                </button>
                {newsTopics.map((topic) => (
                    <button type="button" class="cs-filter-chip" data-topic={topic.slug} aria-pressed="false">
                        {topic.label} <span class="cs-chip-count">{topicCount(topic.slug)}</span>
                    </button>
                ))}
            </div>
            <div class="cs-news-controls">
                <label class="cs-news-search">
                    <span class="cs-visually-hidden">Search news</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14" />
                    </svg>
                    <input type="search" id="news-search" placeholder="Search by keyword" autocomplete="off" />
                </label>
                <label class="cs-news-sort">
                    <span class="cs-visually-hidden">Sort news</span>
                    <select id="news-sort">
                        <option value="newest">Newest first</option>
                        <option value="oldest">Oldest first</option>
                    </select>
                </label>
            </div>
        </div>

        <p class="cs-news-status" id="news-status" aria-live="polite"></p>

        <div class="cs-news-list" id="news-list">
            {news.map((item) => (
                <article class="cs-news-item" data-date={item.date} data-topics={item.topics.join(" ")}>
                    <div class:list={["cs-news-media", { "is-contain": item.fit === "contain" }]}>
                        {item.images.length > 1 ? (
                            <div class="cs-carousel" tabindex="0" aria-roledescription="carousel" aria-label={`${item.title} photos`}>
                                <div class="cs-carousel-track">
                                    {item.images.map((img) => (
                                        <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
                                    ))}
                                </div>
                                <button type="button" class="cs-carousel-btn cs-carousel-prev" aria-label="Previous photo">&#10094;</button>
                                <button type="button" class="cs-carousel-btn cs-carousel-next" aria-label="Next photo">&#10095;</button>
                                <div class="cs-carousel-dots">
                                    {item.images.map((_, i) => (
                                        <button type="button" class:list={["cs-carousel-dot", { "is-active": i === 0 }]} aria-label={`Photo ${i + 1}`}></button>
                                    ))}
                                </div>
                            </div>
                        ) : (
                            <img src={item.images[0].src} alt={item.images[0].alt} loading="lazy" decoding="async" />
                        )}
                    </div>
                    <div class="cs-news-body">
                        <div class="cs-meta">
                            <time class="cs-date" datetime={item.date}>{item.dateLabel}</time>
                            <span class="cs-tag">{item.tag}</span>
                        </div>
                        <h3 class="cs-news-title">{item.title}</h3>
                        <div class="cs-news-text">
                            {item.paragraphs.map((p) => <p>{p}</p>)}
                            {item.list && (
                                <ul>
                                    {item.list.map((li) => <li>{li}</li>)}
                                </ul>
                            )}
                        </div>
                        <button type="button" class="cs-read-more" aria-expanded="false" hidden>Read more</button>
                        <ul class="cs-news-topics">
                            {item.topics.map((slug) => (
                                <li><button type="button" class="cs-topic-link" data-topic={slug}>#{topicLabel[slug]}</button></li>
                            ))}
                        </ul>
                    </div>
                </article>
            ))}
        </div>

        <div class="cs-news-empty" id="news-empty" hidden>
            <p>No news matches your search.</p>
            <button type="button" class="cs-news-reset" id="news-reset">Clear filters</button>
        </div>

        <nav class="cs-pagination" id="news-pagination" aria-label="News pagination"></nav>
    </div>
</section>

</BaseLayout>




<style lang="less">

/*-- -------------------------- -->
<---           Hero             -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
    #hero-2150 {
        /* 300px - 400px on top - leaving extra space for the navigation */
        /* 60px - 100px on bottom */
        padding: clamp(10rem, 40vw, 25rem) (16/16rem) clamp(3.75rem, 7.5vw, 6.25rem) (16/16rem);
        /* prevents the topper line from causing an overflow */
        overflow: hidden;
        position: relative;
        z-index: 1;

        .cs-container {
            width: 100%;
            /* changes to 1280px at tablet */
            max-width: (704/16rem);
            margin: auto;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            /* 48px - 60px */
            gap: clamp(3rem, 6vw, 3.75rem);
        }

        .cs-content {
            text-align: center;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .cs-title {
            /* 39px - 61px */
            position: relative;
            top: -130px;
            font-size: clamp(3rem, 6vw, 5rem);
            max-width: 30ch;
            color: var(--bodyTextColorWhite);
        }
        
        .cs-topper {
            font-size: clamp(1rem, 1.6vw, 1.4rem);
            position: relative;
            top: -130px;
            color: var(--csTopperColor);
        }

        .cs-text {
            /* 16px - 20px */
            position: relative;
            top: 50px;
            font-size: clamp(1rem, 2vw, 1.25rem);
            max-width: 55ch;
            margin-bottom: (32/16rem);
            color: var(--bodyTextColorWhite);
            opacity: 0.8;
        }

        .cs-button-solid {
            position: relative;
            top: 50px;
            font-size: (16/16rem);
            font-weight: 700;
            /* 46px - 56px */
            line-height: clamp(2.875rem, 5.5vw, 3.5rem);
            text-align: center;
            text-decoration: none;
            min-width: (200/16rem);
            margin: 0;
            /* prevents padding from adding to the width */
            box-sizing: border-box;
            /* 32px - 48px */
            padding: 0 clamp(2rem, 4vw, 3rem);
            background-color: var(--primary);
            color: var(--bodyTextColorWhite);
            display: inline-block;
            position: relative;
            z-index: 1;
            transition: color 0.3s;

            &:before {
                content: "";
                width: 0%;
                height: 100%;
                background: #ffffff;
                opacity: 1;
                position: absolute;
                top: 0;
                left: 0;
                z-index: -1;
                transition: width 0.3s;
            }

            &:hover {
                color: var(--headerColor);

                &:before {
                    width: 100%;
                }
            }
        }

        .cs-card-group {
            width: 100%;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            /* 32px - 60px */
            row-gap: clamp(2rem, 4vw, 3.75rem);
        }

        .cs-item {
            text-align: left;
            list-style: none;
            width: 100%;
            margin: 0;
            box-sizing: border-box;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            grid-column: span 12;
            gap: (16/16rem);
        }

        .cs-icon-group {
            margin: 0;
            display: flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            gap: (8/16rem);
        }

        .cs-icon {
            width: (32/16rem);
            height: auto;
            display: block;
        }

        .cs-h3 {
            /* 20px - 25px */
            font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
            font-weight: 700;
            line-height: 1.2em;
            text-align: inherit;
            margin: 0;
            color: var(--bodyTextColorWhite);
            transition: color 0.3s;
        }

        .cs-item-text {
            /* 16px - 20px */
            font-size: clamp(1rem, 2vw, 1.25rem);
            line-height: 1.5em;
            text-align: inherit;
            margin: 0;
            color: #F7F7F7;
            opacity: 0.8;
        }

        .cs-background {
          width: 100%;
          height: 100%;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        
          &:before {
            content: "";
            width: 100%;
            height: 100%;
            background: linear-gradient(0deg, rgba(0, 0, 0, 0.50) 0%, rgba(0, 0, 0, 0.50) 100%);
            pointer-events: none;
            opacity: 1;
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
          }
      
          .cs-slideshow {
            width: 100%;
            height: 100%;
            background-color: #1a1a1a;
            position: absolute;
            top: 0;
            left: 0;
            overflow: hidden;
          }

          .cs-track {
            height: 100%;
            display: flex;
            transition: transform 0.6s ease;
            will-change: transform;
          }

          .cs-slide-frame {
            flex: 0 0 100%;
            width: 100%;
            min-width: 100%;
            height: 100%;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
          }

          /* Portrait: blurred backdrop + full image (set via JS .is-portrait) */
          &.is-portrait {
            .cs-slide-bg {
              display: block;
            }

            .cs-slide {
              position: relative;
              z-index: 1;
              max-width: 100%;
              max-height: 100%;
              width: auto;
              height: auto;
              object-fit: contain;
              object-position: center;
            }
          }

          .cs-slide-bg {
            display: none;
            position: absolute;
            inset: -10%;
            width: 120%;
            height: 120%;
            object-fit: cover;
            object-position: center;
            filter: blur(28px) brightness(0.45) saturate(1.15);
            transform: scale(1.08);
            pointer-events: none;
          }

          .cs-slide {
            position: absolute;
            inset: 0;
            z-index: 1;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
          }

          /* Landscape: single layer, fill the hero */
          &.is-landscape {
            .cs-slide-bg {
              display: none;
            }

            .cs-slide {
              max-width: none;
              max-height: none;
            }
          }
        }

        .cs-slideshow-controls {
          position: absolute;
          inset: 0;
          z-index: 2;
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 0 (12/16rem);
          pointer-events: none;
        }

        .cs-slideshow-btn {
          pointer-events: auto;
          width: (44/16rem);
          height: (44/16rem);
          padding: 0;
          border: 1px solid rgba(255, 255, 255, 0.45);
          border-radius: 50%;
          background: rgba(0, 0, 0, 0.45);
          color: #fff;
          display: flex;
          align-items: center;
          justify-content: center;
          cursor: pointer;
          transition:
            background-color 0.2s,
            border-color 0.2s,
            transform 0.2s;

          svg {
            width: (26/16rem);
            height: (26/16rem);
            fill: currentColor;
          }

          &:hover {
            background: rgba(0, 0, 0, 0.65);
            border-color: rgba(255, 255, 255, 0.85);
          }

          &:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
          }

          &:active {
            transform: scale(0.96);
          }
        }
    }
}

