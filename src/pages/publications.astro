---
import BaseLayout from "src/layouts/BaseLayout.astro";
import publications from "src/data/publications.json";

const LAB_MEMBERS = publications.labMembers.map(n => n.toLowerCase());

function isLabMember(name) {
  const lower = name.toLowerCase().trim();
  return LAB_MEMBERS.some(m => lower === m || lower.includes(m));
}

function formatAuthors(authors) {
  return authors.map(name => {
    if (isLabMember(name)) {
      return `<strong class="cs-lab">${name}</strong>`;
    }
    return name;
  }).join(', ');
}

// Sort all papers by year descending
const sortedPapers = [...publications.papers].sort((a, b) => b.year - a.year);

// Group by year, merge years <= 2022 into "Before 2023"
const byYear = {};
for (const paper of sortedPapers) {
  const groupKey = paper.year <= 2022 ? 'Before 2023' : paper.year;
  if (!byYear[groupKey]) byYear[groupKey] = [];
  byYear[groupKey].push(paper);
}

// Order: individual years descending, "Before 2023" always last
const years = Object.keys(byYear)
  .map(k => k === 'Before 2023' ? { key: k, num: -1 } : { key: k, num: Number(k) })
  .sort((a, b) => b.num - a.num)
  .map(y => y.key);
---

<BaseLayout
  title="Publications - Intelligent Biomechanics Lab"
  description="Publications from the Intelligent Biomechanics Lab."
>

<section id="publications-page">
  <div class="cs-container">

    <header class="cs-header">
      <h1>Publications</h1>
      <a class="cs-scholar" href="https://scholar.google.com/citations?user=t-lHPeMAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a>
    </header>

    {years.map(year => (
      <>
        <h3>{year}</h3>
        <ul class="cs-papers">
          {byYear[year].map(paper => {
            const authorsHtml = formatAuthors(paper.authors);
            const doiLink = paper.doi ? `https://doi.org/${paper.doi}` : null;
            const titleTag = doiLink
              ? `<a href="${doiLink}" class="cs-title-link" target="_blank" rel="noopener">${paper.title}</a>`
              : paper.title;
            return (
              <li>
                <strong set:html={titleTag}></strong>.
                <span class="cs-authors" set:html={authorsHtml}></span>.
                <em>{paper.venue}</em>.
              </li>
            );
          })}
        </ul>
      </>
    ))}

  </div>
</section>

</BaseLayout>


<style>
#publications-page {
  padding: clamp(3rem, 6vw, 5rem) 1rem;
  background: #fafbfc;
  font-family: "Source Sans 3", system-ui, -apple-system, sans-serif;
}
#publications-page .cs-container {
  width: 100%;
  max-width: 56rem;
  margin: 0 auto;
}

/* ---- Header ---- */
.cs-header {
  text-align: center;
  margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  padding-bottom: clamp(1.5rem, 3vw, 2rem);
  border-bottom: 1px solid #e5e7eb;
}
.cs-header h1 {
  font-size: clamp(2rem, 4vw, 2.75rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 1rem;
  color: #0f172a;
}
.cs-scholar {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1.125rem;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--primary);
  text-decoration: none;
  border: 1px solid var(--primary);
  border-radius: 0.375rem;
  background: #fff;
  transition: all 0.2s ease;
}
.cs-scholar:hover {
  background: var(--primary);
  color: #fff;
  text-decoration: none;
}

/* ---- Year labels ---- */
h3 {
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--primary);
  margin: 2rem 0 0.75rem;
  padding-left: 0.75rem;
  border-left: 3px solid var(--primary);
}

/* ---- Paper list ---- */
.cs-papers {
  list-style: none;
  margin: 0;
  padding: 0;
}
.cs-papers li {
  font-size: 0.9375rem;
  line-height: 1.7;
  color: #334155;
  margin-bottom: 0.75rem;
  padding: 0.75rem 1rem;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 0.5rem;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.cs-papers li:hover {
  border-color: var(--primary);
  box-shadow: 0 2px 8px rgba(0, 86, 179, 0.06);
}
.cs-papers li strong {
  color: #0f172a;
  font-weight: 700;
}
.cs-papers li em {
  font-style: italic;
}
.cs-papers li .cs-authors {
  color: #475569;
}
.cs-papers li .cs-lab {
  font-weight: 700;
  color: var(--primary);
}

/* ---- Title as link ---- */
.cs-papers li strong .cs-title-link {
  color: #0f172a;
  font-weight: 700;
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: color 0.15s ease, border-color 0.15s ease;
}
.cs-papers li strong .cs-title-link:hover {
  color: var(--primary);
  border-bottom-color: var(--primary);
}

/* ---- Inline links ---- */
.cs-link {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--primary);
  text-decoration: none;
  margin-left: 0.375rem;
  transition: opacity 0.15s ease;
}
.cs-link:hover {
  opacity: 0.7;
  text-decoration: underline;
}
</style>
